---
import Img from './Img.astro';
import Chevron from './Chevron.astro';
import { site } from '../data/site';
import type { PhotoSlug } from '../data/photos';
interface Props { eyebrow: string; h1: string; lead: string; photo: PhotoSlug; cta?: string; secondary?: { label: string; href: string }; position?: string }
const { eyebrow, h1, lead, photo, cta = 'Estimation gratuite', secondary, position } = Astro.props;
---
<section class="phero section--tint" data-enter>
  <div class="wrap phero-in">
    <div class="phero-text">
      <span class="eyebrow t-stagger-line">{eyebrow}</span>
      <h1 class="t-stagger-line">{h1}</h1>
      <p class="lead t-stagger-line">{lead}</p>
      <div class="btn-row t-stagger-line">
        <a class="btn" href={site.estimationAnchor}>{cta}</a>
        {secondary && <a class="link-arrow" href={secondary.href}><span class="u">{secondary.label}</span><Chevron /></a>}
      </div>
    </div>
    <Img slug={photo} eager class="phero-img" sizes="(max-width: 860px) 100vw, 46vw" widths={[480, 800, 1200]} position={position} />
  </div>
</section>
<style>
  .phero { padding-block: clamp(40px, 6vw, 88px); }
  .phero-in { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(32px, 6vw, 88px); align-items: center; }
  .phero h1 { font-size: clamp(2.2rem, 4.2vw, 3.75rem); }
  :global(.phero-img) { aspect-ratio: 4 / 5; max-height: 640px; width: 100%; }
  @media (max-width: 860px) { .phero-in { grid-template-columns: 1fr; } :global(.phero-img) { aspect-ratio: 4 / 3; order: -1; } }
</style>
