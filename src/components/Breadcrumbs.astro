---
interface Props { items: { name: string; path?: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs wrap" aria-label="Fil d’Ariane">
  <ol>
    <li><a href="/">Accueil</a></li>
    {items.map((it, i) => (
      <li>{it.path && i < items.length - 1 ? <a href={it.path}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>
    ))}
  </ol>
</nav>
