---
import { Picture } from 'astro:assets';
import { photo, type PhotoSlug } from '../data/photos';
import { frameFor, type FrameCtx } from '../lib/frame';

interface Props {
  slug: PhotoSlug;
  /** side : le cadre épouse la photo · card : 4:3 fixe · bleed : fond plein cadre (hero). */
  ctx?: FrameCtx;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
  alt?: string;
  position?: string;
}
const { slug, ctx = 'card', sizes = '(max-width: 860px) 100vw, 50vw', widths = [480, 800, 1200], eager = false, class: cls, alt, position } = Astro.props;
const p = photo(slug);
const f = frameFor(slug, ctx);
---
<div class:list={['frame', cls, f.mat && 'frame--mat', f.tall && 'frame--tall']} style={`--ar:${f.ar};--ar-m:${f.arM}`} data-bleed={ctx === 'bleed' ? '' : undefined}>
  <Picture
    src={p.src}
    alt={alt ?? p.alt}
    title={p.title}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding={eager ? 'sync' : 'async'}
    style={position ? `object-position:${position}` : undefined}
  />
</div>
