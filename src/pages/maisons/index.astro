---
import Layout from '../../layouts/Layout.astro';
import Img from '../../components/Img.astro';
import Chevron from '../../components/Chevron.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { maisons } from '../../data/maisons';
import { departements } from '../../data/site';
import { breadcrumbSchema } from '../../lib/schema';
---
<Layout
  title="Nos 4 maisons d’antiquaires en Bourgogne-Franche-Comté"
  description="Côte-d’Or, Saône-et-Loire, Yonne-Nivernais, Franche-Comté-Jura : découvrez nos quatre maisons régionales d’antiquaires et d’experts d’art."
  ogPhoto="cote-de-beaune"
  jsonLd={[breadcrumbSchema([{ name: 'Accueil', path: '/' }, { name: 'Nos maisons', path: '/maisons/' }])]}
>
  <Breadcrumbs items={[{ name: 'Nos maisons' }]} />
  <PageHero eyebrow="Un réseau, quatre territoires" h1="Nos quatre maisons d’antiquaires en Bourgogne-Franche-Comté" lead="Chaque maison est ancrée dans son terroir et couvre un ensemble de départements, pour que l’expert qui vous reçoit connaisse vos objets, votre région et ses marchés." photo="auxerre-panorama" secondary={{ label: 'Voir les zones d’intervention', href: '/zones-intervention/' }} />
  <section class="section" aria-labelledby="mm-title">
    <div class="wrap">
      <h2 id="mm-title" class="sr-only">Les quatre maisons régionales</h2>
      <div class="rows">
        {maisons.map((m, i) => (
          <article class={`row split ${i % 2 ? 'split--reverse' : ''}`}>
            <Img slug={m.photo} sizes="(max-width: 860px) 100vw, 45vw" />
            <div>
              <span class="eyebrow">Maison {m.numero} · départements {m.departements.join(', ')}</span>
              <h3 class="row-title">{m.nom}</h3>
              <p class="lead">{m.accroche}</p>
              <p>{m.zone}.</p>
              <a class="btn" href={`/maisons/${m.slug}/`}>Découvrir cette maison</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section section--tint" aria-labelledby="dep-title">
    <div class="wrap">
      <h2 id="dep-title">Huit départements <em>couverts</em></h2>
      <ul class="chips">
        {departements.map((d) => <li>{d.nom} ({d.code}) – {d.prefecture}</li>)}
      </ul>
    </div>
  </section>
  <CtaBand />
</Layout>
<style>
  .rows { display: grid; gap: clamp(56px, 9vw, 120px); }
  .row-title { font-size: clamp(2rem, 3.4vw, 3rem); }
</style>
