---
import Layout from '../../layouts/Layout.astro';
import Img from '../../components/Img.astro';
import Chevron from '../../components/Chevron.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { specialites, specialiteBySlug } from '../../data/specialites';
import { maisons } from '../../data/maisons';
import { villes } from '../../data/villes';
import { site } from '../../data/site';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../lib/schema';

export function getStaticPaths() {
  return specialites.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const path = `/specialites/${s.slug}/`;
const voisines = s.voisines.map(specialiteBySlug);
const maisonsConcernees = maisons.filter((m) => m.specialites.includes(s.slug));
---
<Layout
  title={s.title}
  description={s.description}
  ogPhoto={s.photo}
  jsonLd={[
    serviceSchema({ name: s.nom, description: s.description, path, serviceType: `Expertise : ${s.nom}` }),
    faqSchema(s.faq),
    breadcrumbSchema([{ name: 'Accueil', path: '/' }, { name: 'Spécialités', path: '/specialites/' }, { name: s.nom, path }]),
  ]}
>
  <Breadcrumbs items={[{ name: 'Spécialités', path: '/specialites/' }, { name: s.nom }]} />
  <PageHero eyebrow="Spécialité" h1={s.h1} lead={s.accroche} photo={s.photo} secondary={{ label: 'Nos autres spécialités', href: '/specialites/' }} />

  <section class="section" aria-labelledby="intro-title">
    <div class="wrap split">
      <div class="prose">
        <span class="eyebrow">Notre approche</span>
        <h2 id="intro-title"><em>Expertise</em> : {s.court}</h2>
        {s.intro.map((p) => <p>{p}</p>)}
        <p class="note"><strong>Le conseil de l’expert.</strong> {s.conseil}</p>
        <a class="btn" href={site.estimationAnchor}>Estimer mes pièces gratuitement</a>
      </div>
      <Img slug={s.galerie[0] ?? s.photo} sizes="(max-width: 860px) 100vw, 45vw" />
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="criteres-title">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Ce que nous examinons</span>
        <h2 id="criteres-title">Les critères qui font <em>la valeur</em></h2>
      </div>
      <div class="grid grid--4 crit">
        {s.recherche.map((r, i) => (
          <article class="crit-item">
            <span class="crit-n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{r.titre}</h3>
            <p>{r.texte}</p>
          </article>
        ))}
      </div>
      <h3 class="mots-title">Pièces que nous estimons</h3>
      <ul class="chips">{s.mots.map((m) => <li>{m}</li>)}</ul>
    </div>
  </section>

  {s.galerie.length > 1 && (
    <section class="section" aria-labelledby="galerie-title">
      <div class="wrap">
        <h2 id="galerie-title" class="sr-only">Exemples de pièces</h2>
        <div class={`grid grid--${Math.min(s.galerie.length - 1, 3) === 1 ? 2 : Math.min(s.galerie.length - 1, 3)}`}>
          {s.galerie.slice(1).map((g) => <Img slug={g} class="gal" sizes="(max-width: 640px) 100vw, 33vw" />)}
        </div>
      </div>
    </section>
  )}

  <section class="section section--oak" aria-labelledby="ou-title">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Où nous intervenons</span>
        <h2 id="ou-title">Une expertise <em>près de chez vous</em></h2>
        <p class="lead">Cette spécialité est suivie en priorité par {maisonsConcernees.length > 1 ? 'nos maisons' : 'la maison'} {maisonsConcernees.map((m) => m.court).join(', ')}, et dans toute la région Bourgogne-Franche-Comté.</p>
      </div>
      <ul class="chips">
        {villes.slice(0, 10).map((v) => <li><a href={`/antiquaire/${v.slug}/`}>{s.court} à {v.nom}</a></li>)}
      </ul>
    </div>
  </section>

  <Faq items={s.faq} title={`Questions sur : ${s.court}`} />

  <section class="section section--tint" aria-labelledby="voisines-title">
    <div class="wrap">
      <h2 id="voisines-title">Autres expertises</h2>
      <div class="grid grid--3">
        {voisines.map((v) => (
          <a class="card" href={`/specialites/${v.slug}/`}>
            <Img slug={v.photo} sizes="(max-width: 640px) 100vw, 33vw" />
            <div class="card-body"><h3>{v.nom}</h3><span class="link-arrow"><span class="u">Voir la spécialité</span><Chevron /></span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand titre={`Faites estimer vos pièces : <em>${s.court}</em>`} />
</Layout>

<style>
  .note { border-left: 2px solid var(--brass); padding: 4px 0 4px 20px; color: var(--ink); }
  .crit-item { border-top: 1px solid var(--ink); padding-top: 20px; }
  .crit-n { font: 500 2.4rem/1 var(--font-display); color: var(--brass-deep); }
  .crit-item h3 { margin: 10px 0 8px; font-size: 1.4rem; }
  .crit-item p { font-size: .95rem; color: var(--ink-soft); }
  .mots-title { margin: 56px 0 18px; font-size: 1.3rem; }
  :global(.gal) { aspect-ratio: 4 / 3; }
</style>
