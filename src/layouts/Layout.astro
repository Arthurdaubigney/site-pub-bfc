---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../data/site';
import { photo, type PhotoSlug } from '../data/photos';
import { organizationSchema, webSiteSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  ogPhoto?: PhotoSlug;
  jsonLd?: object[];
  noindex?: boolean;
  preloadHero?: boolean;
  /** Masque les boutons d'appel à l'action (page de remerciement). */
  noCta?: boolean;
}
const { title, description, ogPhoto = 'chateau-chambre', jsonLd = [], noindex = false, noCta = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const og = await getImage({ src: photo(ogPhoto).src, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const ogUrl = new URL(og.src, site.url).toString();
const graph = [organizationSchema(), webSiteSchema(), ...jsonLd];
const consentScript = [
  "window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;",
  "gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied'});",
  "(function(){var KEY='cookie-consent',MAX=15552000000;", // 180 jours (recommandation CNIL : 6 mois)
  "function read(){try{var o=JSON.parse(localStorage.getItem(KEY)||'null');if(o&&(o.v==='granted'||o.v==='denied')&&Date.now()-o.t<MAX)return o.v}catch(e){}return null}",
  "window.__consent={read:read,write:function(v){try{localStorage.setItem(KEY,JSON.stringify({v:v,t:Date.now()}))}catch(e){}}};",
  "window.loadAds=function(){if(window.__adsLoaded)return;window.__adsLoaded=true;",
  "gtag('consent','update',{ad_storage:'granted',ad_user_data:'granted',ad_personalization:'granted'});",
  "var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=" + site.adsId + "';document.head.appendChild(s);",
  "gtag('js',new Date());gtag('config','" + site.adsId + "');};",
  "if(read()==='granted')window.loadAds();})();",
].join('');
---
<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="google-site-verification" content="XTFH7_9M4i6Ol2hJtHDvRffVk6i-sE910KZX22-qZL8" />
    <!-- Consentement (Google Consent Mode v2) : tout est refusé par défaut ; la balise Google Ads n'est chargée qu'après accord -->
    <script is:inline set:html={consentScript} />
    <meta name="theme-color" content="#581c25" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="geo.region" content="FR-BFC" />
    <meta name="geo.placename" content="Bourgogne-Franche-Comté" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    {graph.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header noCta={noCta} />
    <main id="contenu"><slot /></main>
    <Footer noCta={noCta} />
    {!noCta && <MobileBar />}
    <CookieBanner />
    <script>
      // Entrée du hero : une seule fois au chargement (transitions.dev – texts reveal)
      requestAnimationFrame(() => requestAnimationFrame(() => document.querySelectorAll('[data-enter]').forEach((el) => el.classList.add('is-shown'))));

      // Header : ombre au scroll + barre CTA mobile après le premier écran
      const hdr = document.querySelector<HTMLElement>('[data-header]');
      const mbar = document.querySelector<HTMLElement>('[data-mbar]');
      // La barre CTA mobile se masque dès que le formulaire est à l'écran (elle le recouvrirait)
      let formVisible = false;
      const onScroll = () => {
        const y = window.scrollY;
        hdr?.classList.toggle('is-stuck', y > 8);
        mbar?.classList.toggle('is-on', y > window.innerHeight * 0.7 && !formVisible);
      };
      const est = document.querySelector('#estimation');
      if (est && 'IntersectionObserver' in window) {
        new IntersectionObserver(([e]) => { formVisible = e.isIntersecting; onScroll(); }).observe(est);
      }
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Menu mobile : ouverture animée, verrouillage du scroll, fermeture (Échap, lien, retour au bureau)
      const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      const setMenu = (open: boolean) => {
        if (!btn || !menu) return;
        btn.setAttribute('aria-expanded', String(open));
        if (open && hdr) menu.style.top = `${hdr.offsetHeight}px`; // l'en-tête peut passer sur 2-3 lignes sur petit écran
        menu.classList.toggle('is-open', open);
        menu.toggleAttribute('inert', !open);
        document.body.style.overflow = open ? 'hidden' : '';
      };
      btn?.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
      menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
      addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') { setMenu(false); btn.focus(); }
      });
      matchMedia('(min-width: 1061px)').addEventListener('change', (e) => { if (e.matches) setMenu(false); });

      // Accordéons (FAQ)
      document.querySelectorAll<HTMLElement>('[data-acc]').forEach((item) => {
        const b = item.querySelector<HTMLButtonElement>('.acc-head');
        b?.addEventListener('click', () => {
          const open = item.dataset.open !== 'true';
          item.dataset.open = String(open);
          b.setAttribute('aria-expanded', String(open));
        });
      });
    </script>
  </body>
</html>
